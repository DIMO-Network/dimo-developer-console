{
  "name": "dimo-developer-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run lint && npm run check:template-types",
    "build": "next build",
    "predev": "npm run compile",
    "dev": "next dev",
    "sec": "next dev --experimental-https",
    "lint": "eslint . --fix --quiet",
    "lint:format": "prettier . --check --log-level warn --write \"./**/*.{js,ts,css,md,json,tsx}\"",
    "start": "next start",
    "test": "jest",
    "test:update-snap": "jest -u",
    "test:watch": "jest --watch",
    "compile": "graphql-codegen --config src/codegen.ts",
    "gen:template-types": "node scripts/gen-template-types.mjs",
    "check:template-types": "node scripts/gen-template-types.mjs --check",
    "prepare": "husky",
    "visual:dev": "bash scripts/visual/dev.sh",
    "visual:shoot": "node scripts/visual/shoot.mjs",
    "visual:check": "bash scripts/visual/check-tokens.sh"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@base-ui/react": "^1.9.0",
    "@dimo-network/data-sdk": "~1.4.0",
    "@ethereumjs/util": "^9.1.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-switch": "^1.4.1",
    "@sentry/nextjs": "^8.55.2",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "@turnkey/crypto": "2.13.2",
    "@turnkey/ethers": "1.3.43",
    "@turnkey/http": "6.6.0",
    "@turnkey/sdk-browser": "8.6.0",
    "@turnkey/sdk-server": "8.6.0",
    "@turnkey/viem": "0.14.43",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/sdk": "^5.5.11",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "encoding": "^0.1.14",
    "file-saver": "^2.0.5",
    "graphql": "^16.14.2",
    "jose": "^6.2.13",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.63.0",
    "maskdata": "^1.3.4",
    "mixpanel-browser": "^2.84.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "~7.68.0",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^2.15.4",
    "shadcn": "^4.23.0",
    "simple-icons": "^16.36.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "validator": "^13.15.35",
    "viem": "2.56.8",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.24.0",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/client-preset": "^5.3.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.27",
    "@types/mixpanel-browser": "^2.60.0",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "~1.59.1",
    "postcss": "^8.5.32",
    "postcss-nesting": "^12.1.5",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "eslint": "$eslint",
    "next": {
      "postcss": "^8.5.32"
    },
    "@sentry/nextjs": {
      "rollup": "^3.30.0"
    }
  }
}
